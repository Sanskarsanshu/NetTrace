# Set default behavior to automatically normalize line endings
* text=auto

# Force LF line endings for all codebase source files, docs, schemas, and configurations
*.cpp text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.cmake text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.css text eol=lf
*.sh text eol=lf
*.golden text eol=lf
*.golden.json text eol=lf
CMakeLists.txt text eol=lf

# Windows shell scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
