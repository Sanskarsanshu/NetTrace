{
  "schemaVersion": "1.0",
  "id": "gateway-routing",
  "name": "Scenario B - Gateway Routing",
  "description": "Two hosts in different subnets connected via an intermediate router. Demonstrates off-subnet delivery via default gateway.",
  "nodes": [
    {
      "id": "host-a",
      "name": "Host A",
      "type": "host",
      "adminState": "up",
      "defaultGateway": "192.168.1.1",
      "interfaces": [
        {
          "id": "eth0",
          "name": "eth0",
          "adminState": "up",
          "ipv4Address": "192.168.1.10",
          "prefixLength": 24,
          "macAddress": "02:00:00:01:00:01",
          "mtuBytes": null
        }
      ]
    },
    {
      "id": "host-b",
      "name": "Host B",
      "type": "host",
      "adminState": "up",
      "defaultGateway": "10.0.0.1",
      "services": [
        {
          "protocol": "UDP",
          "port": 5000,
          "label": "echo"
        }
      ],
      "interfaces": [
        {
          "id": "eth0",
          "name": "eth0",
          "adminState": "up",
          "ipv4Address": "10.0.0.20",
          "prefixLength": 24,
          "macAddress": "02:00:00:03:00:01",
          "mtuBytes": null
        }
      ]
    },
    {
      "id": "r1",
      "name": "Router 1",
      "type": "router",
      "adminState": "up",
      "defaultGateway": null,
      "forwardingEnabled": true,
      "interfaces": [
        {
          "id": "eth0",
          "name": "eth0",
          "adminState": "up",
          "ipv4Address": "192.168.1.1",
          "prefixLength": 24,
          "macAddress": "02:00:00:02:00:01",
          "mtuBytes": null
        },
        {
          "id": "eth1",
          "name": "eth1",
          "adminState": "up",
          "ipv4Address": "10.0.0.1",
          "prefixLength": 24,
          "macAddress": "02:00:00:02:00:02",
          "mtuBytes": null
        }
      ]
    }
  ],
  "links": [
    {
      "id": "l1",
      "a": {
        "nodeId": "host-a",
        "interfaceId": "eth0"
      },
      "b": {
        "nodeId": "r1",
        "interfaceId": "eth0"
      },
      "adminState": "up",
      "directionality": "bidirectional",
      "cost": 1.0,
      "bandwidthBps": 100000000,
      "availableBandwidthBps": null,
      "propagationDelayMs": 1.0,
      "packetLossProbability": 0.0,
      "mtuBytes": 1500
    },
    {
      "id": "l2",
      "a": {
        "nodeId": "host-b",
        "interfaceId": "eth0"
      },
      "b": {
        "nodeId": "r1",
        "interfaceId": "eth1"
      },
      "adminState": "up",
      "directionality": "bidirectional",
      "cost": 1.0,
      "bandwidthBps": 100000000,
      "availableBandwidthBps": null,
      "propagationDelayMs": 1.0,
      "packetLossProbability": 0.0,
      "mtuBytes": 1500
    }
  ]
}
