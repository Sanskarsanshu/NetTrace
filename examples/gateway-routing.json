{
  "schemaVersion": "1.0",
  "id": "gateway-routing-example",
  "name": "Scenario B - Gateway Routing Between Subnets",
  "description": "Two hosts in different subnets (192.168.1.0/24 and 10.0.0.0/24) communicating via default gateway router R1. Demonstrates IP forwarding and TTL decrement.",
  "nodes": [
    {
      "id": "host-a",
      "name": "Host A",
      "type": "host",
      "active": true,
      "position": { "x": 100, "y": 200, "z": 0 },
      "defaultGateway": "192.168.1.1",
      "interfaces": [
        {
          "id": "eth0",
          "name": "eth0",
          "ipv4Address": "192.168.1.10",
          "prefixLength": 24,
          "macAddress": "02:00:00:00:01:01",
          "active": true,
          "mtuBytes": 1500
        }
      ]
    },
    {
      "id": "router-1",
      "name": "Router R1",
      "type": "router",
      "active": true,
      "position": { "x": 350, "y": 200, "z": 0 },
      "forwardingEnabled": true,
      "processingDelayMs": 1.0,
      "interfaces": [
        {
          "id": "eth0",
          "name": "eth0",
          "ipv4Address": "192.168.1.1",
          "prefixLength": 24,
          "macAddress": "02:00:00:00:03:01",
          "active": true,
          "mtuBytes": 1500
        },
        {
          "id": "eth1",
          "name": "eth1",
          "ipv4Address": "10.0.0.1",
          "prefixLength": 24,
          "macAddress": "02:00:00:00:03:02",
          "active": true,
          "mtuBytes": 1500
        }
      ],
      "staticRoutes": []
    },
    {
      "id": "host-b",
      "name": "Host B",
      "type": "host",
      "active": true,
      "position": { "x": 600, "y": 200, "z": 0 },
      "defaultGateway": "10.0.0.1",
      "interfaces": [
        {
          "id": "eth0",
          "name": "eth0",
          "ipv4Address": "10.0.0.20",
          "prefixLength": 24,
          "macAddress": "02:00:00:00:01:02",
          "active": true,
          "mtuBytes": 1500
        }
      ]
    }
  ],
  "links": [
    {
      "id": "link-a-r1",
      "a": { "nodeId": "host-a", "interfaceId": "eth0" },
      "b": { "nodeId": "router-1", "interfaceId": "eth0" },
      "adminState": "up",
      "directionality": "bidirectional",
      "cost": 10,
      "bandwidthBps": 100000000,
      "availableBandwidthBps": 100000000,
      "propagationDelayMs": 2.0,
      "packetLossProbability": 0.0,
      "mtuBytes": 1500
    },
    {
      "id": "link-r1-b",
      "a": { "nodeId": "router-1", "interfaceId": "eth1" },
      "b": { "nodeId": "host-b", "interfaceId": "eth0" },
      "adminState": "up",
      "directionality": "bidirectional",
      "cost": 10,
      "bandwidthBps": 100000000,
      "availableBandwidthBps": 100000000,
      "propagationDelayMs": 2.0,
      "packetLossProbability": 0.0,
      "mtuBytes": 1500
    }
  ]
}
