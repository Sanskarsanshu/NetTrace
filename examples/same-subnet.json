{
  "schemaVersion": "1.0",
  "id": "same-subnet-example",
  "name": "Scenario A - Same Subnet Local Delivery",
  "description": "Two hosts in the 192.168.1.0/24 subnet connected through an Ethernet switch. Demonstrates direct local delivery without IP routing.",
  "nodes": [
    {
      "id": "host-a",
      "name": "Host A",
      "type": "host",
      "active": true,
      "position": { "x": 100, "y": 200, "z": 0 },
      "defaultGateway": null,
      "interfaces": [
        {
          "id": "eth0",
          "name": "eth0",
          "ipv4Address": "192.168.1.10",
          "prefixLength": 24,
          "macAddress": "02:00:00:01:00:01",
          "active": true,
          "mtuBytes": 1500
        }
      ]
    },
    {
      "id": "switch-1",
      "name": "Switch 1",
      "type": "switch",
      "active": true,
      "position": { "x": 300, "y": 200, "z": 0 },
      "interfaces": [
        {
          "id": "port1",
          "name": "port1",
          "ipv4Address": null,
          "prefixLength": null,
          "macAddress": null,
          "active": true,
          "mtuBytes": 1500
        },
        {
          "id": "port2",
          "name": "port2",
          "ipv4Address": null,
          "prefixLength": null,
          "macAddress": null,
          "active": true,
          "mtuBytes": 1500
        }
      ]
    },
    {
      "id": "host-b",
      "name": "Host B",
      "type": "host",
      "active": true,
      "position": { "x": 500, "y": 200, "z": 0 },
      "defaultGateway": null,
      "interfaces": [
        {
          "id": "eth0",
          "name": "eth0",
          "ipv4Address": "192.168.1.20",
          "prefixLength": 24,
          "macAddress": "02:00:00:02:00:01",
          "active": true,
          "mtuBytes": 1500
        }
      ]
    }
  ],
  "links": [
    {
      "id": "link-a-s1",
      "a": { "nodeId": "host-a", "interfaceId": "eth0" },
      "b": { "nodeId": "switch-1", "interfaceId": "port1" },
      "adminState": "up",
      "directionality": "bidirectional",
      "cost": 1,
      "bandwidthBps": 1000000000,
      "availableBandwidthBps": 1000000000,
      "propagationDelayMs": 0.5,
      "packetLossProbability": 0.0,
      "mtuBytes": 1500
    },
    {
      "id": "link-s1-b",
      "a": { "nodeId": "switch-1", "interfaceId": "port2" },
      "b": { "nodeId": "host-b", "interfaceId": "eth0" },
      "adminState": "up",
      "directionality": "bidirectional",
      "cost": 1,
      "bandwidthBps": 1000000000,
      "availableBandwidthBps": 1000000000,
      "propagationDelayMs": 0.5,
      "packetLossProbability": 0.0,
      "mtuBytes": 1500
    }
  ]
}
